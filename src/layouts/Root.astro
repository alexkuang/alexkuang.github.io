---
import "src/styles/global.css";
const { title } = Astro.props;
const isPostsPage = Astro.url.pathname.startsWith("/posts/");
---

<html lang="en" class="h-full [scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" href="/fonts/manrope-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/monaspace-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="application/rss+xml" title="makeshift.computer RSS" href="/rss.xml" />
    <title>{title}</title>
  </head>
  <body class="h-full bg-zinc-50 antialiased dark:bg-zinc-900">
    <header class="site-header">
      <div class="header-inner">
        <a class="site-name" href="/">makeshift.computer</a>
        <nav aria-label="Main navigation">
          <a href="/posts/" aria-current={isPostsPage ? "page" : undefined}>posts</a>
        </nav>
        <div class="theme-controls" role="group" aria-label="Color theme">
          <button type="button" data-theme="light" aria-label="Light theme" title="Light theme">
            <svg
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="size-6"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"
              ></path>
            </svg>
          </button>
          <button type="button" data-theme="dark" aria-label="Dark theme" title="Dark theme">
            <svg
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="size-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"
              ></path>
            </svg>
          </button>
          <button type="button" data-theme="system" aria-label="System theme" title="System theme">
            <svg
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="size-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25"
              ></path>
            </svg>
          </button>
        </div>
      </div>
    </header>
    <main><slot /></main>
  </body>

  <script>
    const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");

    function applyTheme(theme: string) {
      document.documentElement.classList.toggle(
        "dark",
        theme === "dark" || (theme === "system" && systemTheme.matches),
      );
      document.querySelectorAll<HTMLButtonElement>("[data-theme]").forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.theme === theme));
      });
    }

    function initTheme() {
      const storedTheme = localStorage.getItem("theme");
      applyTheme(storedTheme === "light" || storedTheme === "dark" ? storedTheme : "system");
      document.querySelectorAll<HTMLButtonElement>("[data-theme]").forEach((button) => {
        button.addEventListener("click", () => {
          const theme = button.dataset.theme;
          if (theme !== "light" && theme !== "dark" && theme !== "system") return;
          localStorage.setItem("theme", theme);
          applyTheme(theme);
        });
      });
    }

    systemTheme.addEventListener("change", () => {
      const theme = localStorage.getItem("theme");
      if (theme !== "light" && theme !== "dark") applyTheme("system");
    });
    initTheme();
    document.addEventListener("astro:after-swap", initTheme);
  </script>
</html>

<style>
  .site-header {
    max-width: 49rem;
    margin: 0 auto;
    padding: 1.25rem 1.25rem 0;
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 3rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule);
  }
  .site-name {
    margin-right: auto;
    font-size: 0.9375rem;
    font-weight: 650;
    letter-spacing: -0.035em;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.875rem;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  .theme-controls {
    display: flex;
    flex-shrink: 0;
    gap: 0.125rem;
  }
  .theme-controls button {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    color: var(--muted);
    cursor: pointer;
  }
  .theme-controls button:hover,
  .theme-controls button[aria-pressed="true"] {
    color: var(--ink);
    background: var(--rule);
    border-radius: 0.125rem;
  }
  .theme-controls svg {
    width: 1.25rem;
    height: 1.25rem;
  }
  .theme-controls [data-theme="light"] svg {
    width: 1.5rem;
    height: 1.5rem;
  }
  @media (max-width: 380px) {
    .header-inner {
      gap: 0.75rem;
      flex-wrap: wrap;
    }
    .site-name {
      flex-basis: 100%;
    }
  }
</style>
